{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动全栈服务 (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "单独调试后端 (Backend TS)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal"
    }
  ]
}
